cat > zapform/.env.example << 'EOF'
# Database
DATABASE_URL=postgresql://zapform_user:zapform_pass@db:5432/zapform_db

# WhatsApp Business API (Meta)
WHATSAPP_API_TOKEN=seu_token_permanente_aqui
WHATSAPP_PHONE_NUMBER_ID=seu_phone_number_id_aqui
WHATSAPP_VERIFY_TOKEN=seu_token_de_verificacao_webhook

# Google Gemini
GOOGLE_API_KEY=sua_api_key_do_gemini_aqui

# Configurações da aplicação
APP_NAME=ZapForm
APP_VERSION=1.0.0
DEBUG=True
EOF